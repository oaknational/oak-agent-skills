{
  "name": "@oaknational/oak-agent-skills",
  "version": "0.0.0",
  "description": "Oak National Academy's shared agent skills, and the oak-skills tool that syncs them into a repository",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oaknational/oak-agent-skills.git"
  },
  "homepage": "https://github.com/oaknational/oak-agent-skills#readme",
  "bugs": "https://github.com/oaknational/oak-agent-skills/issues",
  "bin": {
    "oak-skills": "dist/cli.js"
  },
  "files": [
    "skills/",
    "templates/",
    "dist/"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.2.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@oaknational/oak-agent-skills": "link:.",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
