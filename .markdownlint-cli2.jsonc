{
  "config": {
    "default": true,
    // Prose is wrapped by sentence, not by column.
    "MD013": false,
    // Changesets writes the same headings under each release.
    "MD024": { "siblings_only": true },
    // Every image needs alt text that says what it shows.
    "MD045": true,
  },
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    // CLAUDE.md is only the "@AGENTS.md" import, with no heading.
    "**/CLAUDE.md",
    // Changeset entries start with frontmatter, not a heading.
    ".changeset/*.md",
    // The design record is kept locally and never committed.
    "docs/adr/**",
    "docs/plans/**",
  ],
}
