{
  // The rules are in .markdownlint.jsonc, which folders can extend.
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    "dist/**",
    "coverage/**",
    // CLAUDE.md is only the "@AGENTS.md" import, with no heading.
    "**/CLAUDE.md",
    // Changeset entries start with frontmatter, not a heading.
    ".changeset/*.md",
    // The design record is kept locally and never committed.
    "docs/adr/**",
    "docs/plans/**",
  ],
}
