{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oaknational/oak-agent-skills/schema/manifest.schema.json",
  "title": "Sync manifest",
  "description": ".agents/skills/.oak-manifest.json in a consuming repository: what oak-skills sync wrote, so status and check can tell what has changed since.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "package", "config", "skills", "symlinks"],
  "$defs": {
    "skillName": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "properties": {
    "manifestVersion": { "const": 1 },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "const": "@oaknational/oak-agent-skills" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "config": {
      "description": "The oakSkills settings the sync used.",
      "type": "object",
      "additionalProperties": false,
      "required": ["profiles", "bundle", "include", "exclude"],
      "properties": {
        "profiles": { "type": "array", "items": { "type": "string" } },
        "bundle": { "type": ["string", "null"] },
        "include": { "type": "array", "items": { "$ref": "#/$defs/skillName" } },
        "exclude": { "type": "array", "items": { "$ref": "#/$defs/skillName" } }
      }
    },
    "skills": {
      "description": "Each synced skill, where it lives in the central repository, and a checksum of every file in it.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/skillName" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "files"],
        "properties": {
          "source": {
            "description": "The skill's folder in the central repository.",
            "type": "string",
            "pattern": "^skills/(?:central|repos/[a-z0-9]{2,4})/[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "files": {
            "description": "Paths relative to the skill's folder, with their SHA-256 checksums.",
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "symlinks": {
      "description": "The links sync created for Claude Code, relative to the repository root.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "target"],
        "properties": {
          "path": { "type": "string", "pattern": "^\\.claude/skills/[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "target": {
            "type": "string",
            "pattern": "^\\.\\./\\.\\./\\.agents/skills/[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        }
      }
    }
  }
}
